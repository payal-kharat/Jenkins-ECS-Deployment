pipeline {

    agent any

    environment {
        AWS_REGION = 'us-east-1'
        TF_IN_AUTOMATION = 'true'
        TF_DIR = 'INFRA'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Test AWS Credentials') {
            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-terraform']
                ]) {
                    sh '''
                        echo "======================================"
                        echo "Testing AWS Credentials"
                        echo "======================================"

                        aws sts get-caller-identity
                    '''
                }
            }
        }

        stage('Terraform Init') {
            steps {
                dir("${TF_DIR}") {
                    withCredentials([
                        [$class: 'AmazonWebServicesCredentialsBinding',
                         credentialsId: 'aws-terraform']
                    ]) {
                        sh '''
                            echo "======================================"
                            echo "Terraform Init"
                            echo "======================================"

                            terraform version
                            terraform init -input=false
                        '''
                    }
                }
            }
        }

        stage('Terraform Validate') {
            steps {
                dir("${TF_DIR}") {
                    withCredentials([
                        [$class: 'AmazonWebServicesCredentialsBinding',
                         credentialsId: 'aws-terraform']
                    ]) {
                        sh '''
                            echo "======================================"
                            echo "Terraform Validate"
                            echo "======================================"

                            terraform validate
                        '''
                    }
                }
            }
        }

        stage('Terraform Plan') {
            steps {
                dir("${TF_DIR}") {
                    withCredentials([
                        [$class: 'AmazonWebServicesCredentialsBinding',
                         credentialsId: 'aws-terraform']
                    ]) {
                        sh '''
                            echo "======================================"
                            echo "Terraform Plan"
                            echo "======================================"

                            terraform plan \
                                -input=false \
                                -out=tfplan
                        '''
                    }
                }
            }
        }

        stage('Terraform Apply') {
            steps {
                dir("${TF_DIR}") {
                    withCredentials([
                        [$class: 'AmazonWebServicesCredentialsBinding',
                         credentialsId: 'aws-terraform']
                    ]) {
                        sh '''
                            echo "======================================"
                            echo "Terraform Apply"
                            echo "======================================"

                            terraform apply \
                                -input=false \
                                -auto-approve \
                                tfplan
                        '''
                    }
                }
            }
        }
    }

    post {

        success {
            echo "Terraform infrastructure deployment completed successfully."

            dir("${TF_DIR}") {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'AWS']
                ]) {
                    sh '''
                        echo "Terraform Outputs:"
                        terraform output
                    '''
                }
            }
        }

        failure {
            echo "Terraform infrastructure deployment failed."
            echo "Check the Jenkins console output."
        }
    }
}
