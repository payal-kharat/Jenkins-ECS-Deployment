
pipeline {

    agent any

    environment {
        AWS_REGION = 'us-east-1'
        TF_IN_AUTOMATION = 'true'
        TF_DIR = 'INFRA'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Check Terraform Files') {
            steps {
                sh '''
                    echo "======================================"
                    echo "Checking Terraform Configuration"
                    echo "======================================"

                    echo "Current directory:"
                    pwd

                    echo ""
                    echo "Terraform files:"
                    find INFRA -name "*.tf" -type f | sort
                '''
            }
        }

        stage('Terraform Init') {
            steps {
                dir("${TF_DIR}") {
                    sh '''
                        echo "======================================"
                        echo "Terraform Init"
                        echo "======================================"

                        terraform version
                        terraform init -input=false
                    '''
                }
            }
        }

        stage('Terraform Validate') {
            steps {
                dir("${TF_DIR}") {
                    sh '''
                        echo "======================================"
                        echo "Terraform Validate"
                        echo "======================================"

                        terraform validate
                    '''
                }
            }
        }

        stage('Terraform Plan') {
            steps {
                dir("${TF_DIR}") {
                    sh '''
                        echo "======================================"
                        echo "Terraform Plan"
                        echo "======================================"

                        terraform plan \
                            -input=false \
                            -out=tfplan
                    '''
                }
            }
        }

        stage('Terraform Apply') {
            steps {
                dir("${TF_DIR}") {
                    sh '''
                        echo "======================================"
                        echo "Terraform Apply"
                        echo "======================================"

                        terraform apply \
                            -input=false \
                            -auto-approve \
                            tfplan
                    '''
                }
            }
        }
    }

    post {

        success {
            echo "======================================"
            echo "Terraform infrastructure deployment completed successfully."
            echo "======================================"

            dir("${TF_DIR}") {
                sh '''
                    echo "Terraform Outputs:"
                    terraform output
                '''
            }
        }

        failure {
            echo "======================================"
            echo "Terraform infrastructure deployment failed."
            echo "Check the Jenkins console output."
            echo "======================================"
        }
    }
}

